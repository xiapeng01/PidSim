<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <VersionMajor>0</VersionMajor>
    <VersionMinor>1</VersionMinor>
    <VersionBaseDate>2000-01-01</VersionBaseDate>
    <BuildTimestamp>$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss'))</BuildTimestamp>
    <BuildDays>$([System.DateTime]::Parse($(BuildTimestamp)).Date.Subtract($([System.DateTime]::Parse($(VersionBaseDate)))).Days)</BuildDays>
    <BuildHour>$([System.DateTime]::Parse($(BuildTimestamp)).TimeOfDay.Hours)</BuildHour>
    <BuildMinute>$([System.DateTime]::Parse($(BuildTimestamp)).TimeOfDay.Minutes)</BuildMinute>
    <BuildSecond>$([System.DateTime]::Parse($(BuildTimestamp)).TimeOfDay.Seconds)</BuildSecond>
    <BuildSeconds>$([MSBuild]::Add($([MSBuild]::Multiply($(BuildHour), 3600)), $([MSBuild]::Add($([MSBuild]::Multiply($(BuildMinute), 60)), $(BuildSecond)))))</BuildSeconds>
    <!-- .NET 程序集版本号每段最大 65534，第四段采用标准 .NET 自动版本号规则：当天秒数 / 2 -->
    <BuildRevision>$([System.Convert]::ToInt32($([System.Math]::Floor($([MSBuild]::Divide($(BuildSeconds), 2))))))</BuildRevision>
    <Version>$(VersionMajor).$(VersionMinor).$(BuildDays).$(BuildRevision)</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
