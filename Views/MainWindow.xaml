<Window x:Class="PidSimulator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PidSimulator.Views"
        xmlns:controls="clr-namespace:PidSimulator.Controls"
        xmlns:vm="clr-namespace:PidSimulator.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="PID 模拟测试台 - WPF .NET 10 MVVM"
        Icon="/Assets/app.ico"
        Height="780"
        Width="1320"
        MinHeight="640"
        MinWidth="1080"
        Background="{DynamicResource WindowBg}"
        BorderThickness="0">
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Background="{DynamicResource WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource WindowBgAlt}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                MouseLeftButtonDown="HeaderBorder_MouseLeftButtonDown">
            <Grid Margin="16,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,10,0"/>
                    <TextBlock Text="PID 模拟测试台" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Text="实时仿真" FontSize="12" Foreground="{DynamicResource TextSubtle}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Width="40" Style="{StaticResource WindowControlButton}"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip="{Binding ThemeToggleToolTip}">
                        <TextBlock Text="{Binding ThemeGlyph}" FontFamily="Segoe UI Symbol"
                                   FontSize="19" Foreground="{DynamicResource Accent}"/>
                    </Button>
                    <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="6,8,10,8"/>
                    <Button Content="−" Style="{StaticResource WindowControlButton}"
                            Click="MinimizeButton_Click" ToolTip="最小化"/>
                    <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource WindowControlButton}"
                            Click="MaximizeButton_Click" ToolTip="最大化 / 还原"/>
                    <Button Content="×" Style="{StaticResource CloseWindowButton}"
                            Click="CloseButton_Click" ToolTip="关闭"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource WindowBg}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Success}" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Width="92" Margin="0,0,8,0"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding StartCommand}">
                        <TextBlock Text="开始模拟" Foreground="#FFFFFF"/>
                    </Button>
                    <Button Width="64" Margin="0,0,8,0"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding StopCommand}">
                        <TextBlock Text="停止" Foreground="#FFFFFF"/>
                    </Button>
                    <Button Content="单步" Width="64" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding StepOnceCommand}"/>
                    <Button Content="复位" Width="64" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ResetSimulationCommand}"/>
                    <Button Content="清曲线" Width="72"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClearChartCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="16,14,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,10,0">
                <StackPanel>
                    <GroupBox Header="运行设置">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="仿真模型" Style="{StaticResource ParamLabel}"/>
                                <ComboBox Grid.Column="1"
                                          Background="{DynamicResource InputBg}"
                                          BorderBrush="{DynamicResource BorderBrush}"
                                          Foreground="{DynamicResource TextPrimary}"
                                          ItemsSource="{Binding SimulationModelNames}"
                                          SelectedItem="{Binding SelectedSimulationModelName}"
                                          IsEnabled="{Binding CanSwitchStructure}"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PID 类型" Style="{StaticResource ParamLabel}"/>
                                <ComboBox Grid.Column="1"
                                          Background="{DynamicResource InputBg}"
                                          BorderBrush="{DynamicResource BorderBrush}"
                                          Foreground="{DynamicResource TextPrimary}"
                                          ItemsSource="{Binding PidTypeNames}"
                                          SelectedItem="{Binding SelectedPidTypeName}"
                                          IsEnabled="{Binding CanSwitchStructure}"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="设定值 SP" Style="{StaticResource ParamLabel}"/>
                                <Slider Grid.Column="1"
                                        Minimum="{Binding SetpointMinimum}" Maximum="{Binding SetpointMaximum}"
                                        SmallChange="0.1" LargeChange="1"
                                        VerticalAlignment="Center"
                                        Value="{Binding Setpoint, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Column="2" Margin="8,0,0,0"
                                         HorizontalContentAlignment="Right"
                                         Text="{Binding Setpoint, UpdateSourceTrigger=LostFocus,StringFormat=F3}"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="初始 PV" Style="{StaticResource ParamLabel}"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding InitialValue, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>

                            <TextBlock Style="{StaticResource HintText}"
                                       Text="运行中修改参数会立即生效；切换仿真模型或 PID 类型需先停止仿真。"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{Binding PidParameterHeader}">
                        <StackPanel>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Kp 比例" Style="{StaticResource ParamLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding Kp, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Ki 积分" Style="{StaticResource ParamLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding Ki, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Kd 微分" Style="{StaticResource ParamLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding Kd, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="输出下限" Style="{StaticResource ParamLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding OutputMin, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="输出上限" Style="{StaticResource ParamLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding OutputMax, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="采样周期 Ts" Style="{StaticResource ParamLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding SampleTime, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Grid Margin="0,3" Visibility="{Binding IsIncremental, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="增量限幅 Δmax" Style="{StaticResource ParamLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding DeltaMax, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Grid Margin="0,3" Visibility="{Binding IsPositional, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="积分限幅 Σe" Style="{StaticResource ParamLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding IntegralMax, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="水泵流量计参数"
                              Visibility="{Binding IsFlowModel, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="指令下限" Style="{StaticResource ParamLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding PumpMinCommand, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="指令上限" Style="{StaticResource ParamLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding PumpMaxCommand, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="输出下限" Style="{StaticResource ParamLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding PumpMinOutput, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="输出上限" Style="{StaticResource ParamLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding PumpMaxOutput, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="时间常数 τ" Style="{StaticResource ParamLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding PumpTimeConstant, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="滞后时间 Td" Style="{StaticResource ParamLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding PumpDelayTime, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="默认 -3000~-10、3000~10 对应原方法；如需单向泵，可改成 0~3000 与 0~10。"
                                       Margin="0,10,0,0"/>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="滞后时间单位秒，可填小数（如 0.01），填 0 表示不启用。水泵每 10ms 运算一次并把输出放到下标 0：滞后 0.01s 取下标 1，1s 取下标 100，历史长度不足时读数为 0。"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{Binding PlantParameterHeader}"
                              Visibility="{Binding IsTemperatureModel, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="环境温度 Ta" Style="{StaticResource ParamLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding AmbientTemperature, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="满功率温差" Style="{StaticResource ParamLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding MaxTemperatureDelta, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="满功率指令" Style="{StaticResource ParamLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding MaxTemperatureCommand, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="时间常数 τ" Style="{StaticResource ParamLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding TemperatureTimeConstant, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="滞后时间 Td" Style="{StaticResource ParamLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding TemperatureDelayTime, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="环境温度是指令为 0 时的稳态温度；满功率温差是满功率指令下相对环境温度的最大温差；热惯性由时间常数 τ 决定。"
                                       Margin="0,10,0,0"/>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="滞后时间单位秒，可填小数，填 0 表示不启用。温控模型同样每 10ms 运算一次：0.01s 取下标 1，1s 取下标 100。"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <UniformGrid Columns="4" Rows="1">
                    <Grid Margin="4,0,10,0">
                        <Border BorderBrush="{DynamicResource Accent}" BorderThickness="4,0,0,0"
                                CornerRadius="12" Margin="-4,0,0,0" IsHitTestVisible="False"/>
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14" MinHeight="84">
                            <Grid>
                                <TextBlock Text="过程值 PV" Foreground="{DynamicResource TextMuted}"
                                           FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding ProcessValue, StringFormat=F3}" Foreground="{DynamicResource Accent}"
                                           FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Margin="0,8,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Margin="4,0,10,0">
                        <Border BorderBrush="{DynamicResource Success}" BorderThickness="4,0,0,0"
                                CornerRadius="12" Margin="-4,0,0,0" IsHitTestVisible="False"/>
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14" MinHeight="84">
                            <Grid>
                                <TextBlock Text="设定值 SP" Foreground="{DynamicResource TextMuted}"
                                           FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding Setpoint, StringFormat=F3}" Foreground="{DynamicResource Success}"
                                           FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Margin="0,8,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Margin="4,0,10,0">
                        <Border BorderBrush="{DynamicResource SeriesOutput}" BorderThickness="4,0,0,0"
                                CornerRadius="12" Margin="-4,0,0,0" IsHitTestVisible="False"/>
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14" MinHeight="84">
                            <Grid>
                                <TextBlock Text="PID 输出" Foreground="{DynamicResource TextMuted}"
                                           FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding PidOutput, StringFormat=F1}" Foreground="{DynamicResource SeriesOutput}"
                                           FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Margin="0,8,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Margin="4,0,0,0">
                        <Border BorderBrush="{DynamicResource Warning}" BorderThickness="4,0,0,0"
                                CornerRadius="12" Margin="-4,0,0,0" IsHitTestVisible="False"/>
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14" MinHeight="84">
                            <Grid>
                                <TextBlock Text="误差 e" Foreground="{DynamicResource TextMuted}"
                                           FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding Error, StringFormat=F3}" Foreground="{DynamicResource Warning}"
                                           FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Margin="0,8,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </UniformGrid>

                <Border Grid.Row="1"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Margin="0,12,0,0"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <controls:ChartCanvas Grid.Row="0"
                                              Margin="4"
                                              Samples="{Binding Samples}"
                                              GridBrush="{DynamicResource ChartGrid}"
                                              PlotBorderBrush="{DynamicResource ChartBorder}"
                                              TextBrush="{DynamicResource ChartText}"
                                              MutedBrush="{DynamicResource ChartMuted}"
                                              ProcessBrush="{DynamicResource SeriesProcess}"
                                              SetpointBrush="{DynamicResource SeriesSetpoint}"
                                              OutputBrush="{DynamicResource SeriesOutput}"
                                              PlotBackgroundBrush="{DynamicResource PlotBg}"/>

                        <Border Grid.Row="1" HorizontalAlignment="Center" Margin="0,4,0,0"
                                Background="{DynamicResource CardBgSoft}" CornerRadius="8" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="18" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource SeriesProcess}"/>
                                <TextBlock Text="过程值 PV" Margin="5,0,16,0" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                <Rectangle Width="18" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource SeriesSetpoint}"/>
                                <TextBlock Text="设定值 SP" Margin="5,0,16,0" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                <Rectangle Width="18" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource SeriesOutput}"/>
                                <TextBlock Text="PID 输出（右轴）" Margin="5,0,0,0" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,9"
                        Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource AccentSoft}" CornerRadius="5" Padding="7,2" Margin="0,0,10,0">
                            <TextBlock Text="运行信息" Foreground="{DynamicResource Accent}" FontSize="11"/>
                        </Border>
                        <TextBlock Text="仿真时间" Foreground="{DynamicResource TextMuted}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding ElapsedSeconds, StringFormat=F2}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,20,0"/>
                        <TextBlock Text="诊断" Foreground="{DynamicResource TextMuted}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding DiagnosticText}" Foreground="{DynamicResource Warning}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
